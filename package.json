{
  "name": "curse-meter",
  "version": "1.0.0",
  "description": "StreamElements Twitch overlay widget for tracking blesses, curses, and blurses",
  "scripts": {
    "build": "tsc",
    "watch": "tsc --watch",
    "dev": "tsc && node scripts/devServer.js",
    "serve": "node scripts/devServer.js",
    "pretest": "tsc",
    "test": "jest",
    "lint": "eslint .",
    "lint:fix": "eslint . --fix",
    "fix": "npm run format && npm run lint:fix && npm run build",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "check:widget-js": "npm run build && git diff --exit-code -- widget/widget.js",
    "prepare": "husky"
  },
  "devDependencies": {
    "@eslint/js": "^10.0.1",
    "@types/jest": "^29.5.0",
    "@types/jquery": "^3.5.34",
    "@types/jsdom": "^27.0.0",
    "@types/node": "^20.0.0",
    "eslint": "^10.10.0",
    "eslint-config-prettier": "^10.1.8",
    "globals": "^17.12.0",
    "husky": "^9.1.7",
    "jest": "^29.7.0",
    "jquery": "^3.7.1",
    "jsdom": "^25.0.0",
    "prettier": "^3.9.7",
    "ts-jest": "^29.3.0",
    "typescript": "^5.7.0",
    "typescript-eslint": "^8.70.0"
  }
}
